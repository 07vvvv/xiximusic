<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网自建服务端为明文 HTTP（http://10.0.2.2:3200 或 http://192.168.x.x:3200）。
  Android 9+ 默认禁止明文流量，这里显式放开。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
